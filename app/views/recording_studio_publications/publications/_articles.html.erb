<% article_entries = local_assigns.fetch(:article_entries) %>
<% publication_recording = local_assigns.fetch(:publication_recording) %>
<% publication = local_assigns.fetch(:publication) %>
<% articles_count = local_assigns.fetch(:articles_count) %>
<% edit_publication_action = local_assigns[:edit_publication_action] %>

<div class="space-y-4">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Articles",
    subtitle: "#{articles_count} #{'article'.pluralize(articles_count)} published by #{publication.name}"
  ) %>

  <div class="flex flex-wrap items-center gap-2">
    <%= render FlatPack::Button::Component.new(
      text: "View all",
      href: preserve_anchor_url(admin_publication_articles_path(publication_recording)),
      style: :secondary
    ) %>
    <% if edit_publication_action %>
      <%= render FlatPack::Button::Component.new(
        text: "Add article",
        href: preserve_anchor_url(new_admin_publication_article_path(publication_recording)),
        style: :primary
      ) %>
    <% end %>
  </div>

  <% if article_entries.any? %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% article_entries.each do |entry| %>
        <%= render "recording_studio_publications/published_articles/article_row",
                   entry: entry,
                   publication_recording: publication_recording %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">No articles yet.</p>
  <% end %>
</div>
