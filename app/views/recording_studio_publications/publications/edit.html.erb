<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "Edit publication",
    page_nav_anchor_url: action_close_url(default: inventory_path)
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit publication",
    subtitle: @publication.name
  ) %>

  <div class="space-y-6">
    <% if defined?(RecordingStudioPublishable::QuickActions::Component) %>
      <div class="flex items-center gap-2">
        <%= render RecordingStudioPublishable::QuickActions::Component.new(recording: @recording) %>
      </div>
    <% end %>

    <%= render "logo",
               logo_recording: @logo_recording,
               return_to: edit_admin_publication_path(@recording) %>

    <%= form_with model: @publication,
                  url: admin_publication_path(@recording),
                  method: :patch do %>
      <%= hidden_field_tag :anchor_url, page_nav_anchor_url if page_nav_anchor_url.present? %>
      <%= render "form",
                 publication: @publication,
                 cancel_url: preserve_anchor_url(admin_publication_path(@recording)) %>
    <% end %>
  </div>
<% end %>
