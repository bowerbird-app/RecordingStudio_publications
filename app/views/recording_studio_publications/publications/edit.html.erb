<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "Edit publication",
    page_nav_anchor_url: page_nav_anchor_url(default: inventory_path)
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit publication",
    subtitle: @publication.name
  ) %>

  <div class="space-y-6">
    <% if @current_publishable && defined?(RecordingStudioPublishable::StatusBadge::Component) %>
      <%= render RecordingStudioPublishable::StatusBadge::Component.new(publishable: @current_publishable) %>
    <% end %>

    <% if @publishable_edit_path %>
      <div class="flex items-center gap-2">
        <%= render FlatPack::Button::Component.new(
          text: publication_public_page_button_text(@current_publishable),
          href: preserve_anchor_url(@publishable_edit_path),
          style: :secondary
        ) %>
      </div>
    <% end %>

    <%= render "logo",
               logo_recording: @logo_recording,
               return_to: edit_admin_publication_path(@recording) %>

    <%= form_with model: @publication,
                  url: admin_publication_path(@recording),
                  method: :patch do %>
      <%= render "form",
                 publication: @publication,
                 cancel_url: admin_publication_path(@recording) %>
    <% end %>
  </div>
<% end %>
