<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "New publication",
    page_nav_anchor_url: page_nav_anchor_url(default: inventory_path)
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "New publication",
    subtitle: "Add a title to the directory"
  ) %>

  <%= form_with model: @publication,
                url: admin_publications_path,
                method: :post,
                multipart: true do %>
    <%= render "form", publication: @publication, cancel_url: inventory_path %>
  <% end %>
<% end %>
