<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "Edit article",
    page_nav_anchor_url: page_nav_anchor_url(default: admin_publication_article_path(@publication_recording, @recording))
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit article",
    subtitle: @article.title
  ) %>

  <div class="space-y-6">
    <%= render "screenshot",
               screenshot_recording: @screenshot_recording,
               article_recording: @recording,
               article: @article,
               return_to: edit_admin_publication_article_path(@publication_recording, @recording) %>

    <%= form_with model: @article,
                  as: :article,
                  url: admin_publication_article_path(@publication_recording, @recording),
                  method: :patch do %>
      <%= render "form",
                 article: @article,
                 cancel_url: admin_publication_article_path(@publication_recording, @recording) %>
    <% end %>
  </div>
<% end %>
