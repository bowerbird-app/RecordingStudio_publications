<% entry = local_assigns.fetch(:entry) %>
<% publication_recording = local_assigns.fetch(:publication_recording) %>
<% article = entry.article %>
<% href = admin_publication_article_path(publication_recording, entry.recording) %>

<%= render FlatPack::List::Item.new(
  href: preserve_anchor_url(href),
  hover: true
) do %>
  <div class="flex flex-col gap-1">
    <span><%= article.title %></span>
    <span class="text-sm text-(--surface-muted-content-color)">
      <%= [article.byline.presence, article.published_on&.to_fs(:long)].compact.join(" · ").presence || "Article" %>
    </span>
  </div>
<% end %>
