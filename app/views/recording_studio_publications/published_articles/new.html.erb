<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "New article",
    page_nav_anchor_url: page_nav_anchor_url(default: admin_publication_articles_path(@publication_recording))
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "New article",
    subtitle: @publication.name
  ) %>

  <%= form_with model: @article,
                as: :article,
                url: admin_publication_articles_path(@publication_recording),
                method: :post do %>
    <%= render "form",
               article: @article,
               cancel_url: admin_publication_articles_path(@publication_recording) %>
  <% end %>
<% end %>
