<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "New article",
    page_nav_anchor_url: action_close_url(default: articles_admin_path(@publication))
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "New article",
    subtitle: @publication.name
  ) %>

  <%= form_with model: @article,
                as: :article,
                url: admin_publication_articles_path(@publication_recording),
                method: :post do %>
    <%= hidden_field_tag :anchor_url, page_nav_anchor_url if page_nav_anchor_url.present? %>
    <%= render "form",
               article: @article,
               cancel_url: action_close_url(default: articles_admin_path(@publication)) %>
  <% end %>
<% end %>
