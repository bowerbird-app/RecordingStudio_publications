<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
          brand_abbr: "RS",
          title: "Publications",
          subtitle: "Recording Studio"
        ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Home",
            href: "/",
            icon: :home,
            current: request.path == "/"
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Publications admin",
            href: "/admin",
            icon: :rectangle_stack,
            current: request.path.start_with?("/admin")
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Install",
            href: docs_install_path,
            icon: :folder,
            current: request.path == docs_install_path
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Config",
            href: docs_config_path,
            icon: :cog_6_tooth,
            current: request.path == docs_config_path
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Recordable types",
            href: docs_recordable_types_path,
            icon: :queue_list,
            current: request.path == docs_recordable_types_path
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Recordings tree",
            href: docs_recordings_tree_path,
            icon: :folder,
            current: request.path == docs_recordings_tree_path
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Gem views",
            href: docs_gem_views_path,
            icon: :document,
            current: request.path == docs_gem_views_path
          ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Methods",
            href: docs_methods_path,
            icon: :code_bracket,
            current: request.path == docs_methods_path
          ) %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
            text: "Sign out",
            href: main_app.destroy_user_session_path,
            icon: :lock,
            class: "mx-0",
            data: { turbo_method: :delete }
          ) %>
    <% end %>
  <% end %>
<% end %>
