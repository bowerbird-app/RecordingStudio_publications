<%# Core default_layout puts data-theme on body. Flatpack named themes
    must live on html/:root so --button-primary-* aliases inherit charcoal,
    not :root's default blue. This hook does not fork the layout. %>
<script>
  document.documentElement.setAttribute("data-theme", "rounded");
</script>
<%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
