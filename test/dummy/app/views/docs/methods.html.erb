<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public write and lookup helpers on RecordingStudioPublications.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Record an article",
    subtitle: "RecordingStudioPublications.record_article!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      recording = RecordingStudioPublications.record_article!(
        publication,
        {
          title: "House in the Rainforest",
          url: "https://www.theatlantic.com/house-in-the-rainforest",
          published_on: Date.new(2024, 3, 12),
          byline: "Jane Architect",
          excerpt: "A house designed around the existing trees."
        },
        actor: current_user
      )

      recording.parent_recording == RecordingStudioPublications.recording_for(publication)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "List articles for a title",
    subtitle: "RecordingStudioPublications.articles_for",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      articles = RecordingStudioPublications.articles_for(publication)
      screenshot = RecordingStudioPublications.screenshot_recording_for(articles.first)
    CODE
  ) %>
</div>
